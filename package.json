    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server run start",
    "server:test": "npm --prefix server test",
    "server:check-live": "npm --prefix server run check:live",
    "verify": "npm run typecheck && npm test && npm --prefix server run typecheck && npm --prefix server test"
  },
  "dependencies": {
