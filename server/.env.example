# Copy to `.env` to override defaults. Every setting is optional.

# Where the API listens. 0.0.0.0 lets a phone on your Wi-Fi reach it.
PORT=8787
HOST=0.0.0.0

# Sources are tried in order; the first that returns draws wins.
#   import  - your own files in data/imports/<game-slug>.json or .csv
#   thelott - The Lott's public data API + how-to-play pages
#   sample  - clearly labelled generated data (never real results)
SOURCE_ORDER=import,thelott,sample

# How long a snapshot is served before a background refresh (minutes).
CACHE_TTL_MINUTES=360
# Draws of history to collect per game (10-300). The Lott serves them in small windows.
HISTORY_DRAWS=100

# Politeness toward the upstream site.
REQUEST_DELAY_MS=600
REQUEST_TIMEOUT_MS=20000

# Optional overrides
# USER_AGENT=LuckyApe/1.0 (+https://github.com/CruelApe/LuckyApe; independent statistical tool)
# THELOTT_COMPANY=Tattersalls
# DATA_DIR=./data
# LOG_LEVEL=info
