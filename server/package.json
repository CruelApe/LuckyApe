    "test": "vitest run",
    "check:live": "tsx scripts/check-live.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
