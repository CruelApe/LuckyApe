{
  "name": "lucky-ape-server",
  "version": "1.0.0",
  "description": "Scraper and cache service for Lucky Ape: ingests The Lott results and rules and serves them as JSON.",
  "private": true,
  "author": "Tyron James Gono",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
